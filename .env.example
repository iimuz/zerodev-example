# ZeroDev RPC URL
# Get this from https://dashboard.zerodev.app/ by creating a project
# Make sure to select Sepolia network for testing
ZERODEV_RPC=https://rpc.zerodev.app/api/v2/bundler/YOUR_PROJECT_ID

# Private Key (for testing only - use a test key, not a real one)
# You can generate a random key or use any test private key
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
