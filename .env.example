# Note: このファイルはフロントエンドでは使用されません
# フロントエンドでは、ブラウザのUIから直接設定を入力します

# ZeroDev RPC URL（参考）
# Get this from https://dashboard.zerodev.app/ by creating a project
# Make sure to select Sepolia network for testing
# VITE_ZERODEV_RPC=https://rpc.zerodev.app/api/v2/bundler/YOUR_PROJECT_ID

# Private Key（参考 - 本番環境では絶対に使用しないでください）
# VITE_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# セキュリティ警告:
# 本番環境では秘密鍵をフロントエンドに直接埋め込まないでください。
# 代わりに、Passkey認証やソーシャルログインを使用してください。
